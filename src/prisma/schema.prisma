// Get To Know Me database schema. Migrations live in /migrations.
// The table for email tokens is added in its own phase (see IMPLEMENTATION-PLAN.md).

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  viewer
  editor
  admin
}

enum ProfileStatus {
  invited
  awaiting_review
  published
}

/// A person who can sign in. Created on first login and linked to a profile by matching email.
model User {
  id                   String    @id @default(uuid(7)) @db.Uuid
  /// Trimmed, lowercased and @singular.co.za only (enforced by a check constraint).
  email                String    @unique
  /// Null until the user sets a password after verifying their email.
  passwordHash         String?   @map("password_hash")
  role                 UserRole  @default(viewer)
  failedSignInAttempts Int       @default(0) @map("failed_sign_in_attempts")
  lockedAt             DateTime? @map("locked_at") @db.Timestamptz(3)
  emailVerifiedAt      DateTime? @map("email_verified_at") @db.Timestamptz(3)
  lastSignInAt         DateTime? @map("last_sign_in_at") @db.Timestamptz(3)
  /// Set when a user with no profile asks for one; editors see it in their list of accounts without a profile.
  profileRequestedAt   DateTime? @map("profile_requested_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions             Session[]

  @@map("users")
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored, so a database leak cannot be used to sign in.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A Get To Know Me profile. A field that was not entered is null; which fields are required is still to be decided.
model Profile {
  id                   String        @id @default(uuid(7)) @db.Uuid
  /// Trimmed, lowercased and @singular.co.za only (enforced by a check constraint). Links the profile to a user.
  companyEmail         String        @unique @map("company_email")
  firstName            String?       @map("first_name")
  lastName             String?       @map("last_name")
  preferredName        String?       @map("preferred_name")
  position             String?
  startDate            DateTime?     @map("start_date") @db.Date
  /// Optional; hidden on the profile when null.
  linkedIn             String?       @map("linked_in")
  /// Section "Beyond the office gates".
  hobbies              String?
  /// Section "Beyond the bio".
  somethingInteresting String?       @map("something_interesting")
  /// Section "Educational & professional background".
  background           String?
  /// Storage key of the compressed photo; the storage service is chosen in phase 4.
  photoKey             String?       @map("photo_key")
  status               ProfileStatus @default(published)
  publishedAt          DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  invite               Invite?
  photo                ProfilePhoto?

  @@index([status, startDate])
  @@map("profiles")
}

/// An employee's photo, already cropped and compressed. Kept in its own table so listing profiles never loads image bytes.
/// Stored in the database for now because photo storage is still to be decided; see PhotoService to swap it for object storage.
model ProfilePhoto {
  profileId   String   @id @map("profile_id") @db.Uuid
  data        Bytes
  contentType String   @map("content_type")
  /// Changes whenever the photo is replaced, so browsers do not keep showing the old one.
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_photos")
}

/// A private link that lets a new joiner fill in their own profile without signing in. The link holds a random token;
/// only its SHA-256 hash is stored. One invite per profile: sending a new link replaces the token.
model Invite {
  id          String    @id @default(uuid(7)) @db.Uuid
  profileId   String    @unique @map("profile_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the employee submits the form; the link no longer works after that.
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("invites")
}

/// What an audit event records. Account actions are done to a user; the rest are done to a profile.
enum AuditAction {
  role_changed
  account_unlocked
  account_locked
  profile_created
  profile_updated
  profile_published
  profile_deleted
  photo_saved
  invite_created
  invite_renewed
  invite_cancelled
  invite_submitted
}

/// Who caused an audit event: a signed-in user, a new joiner using their private invite link, or the system itself.
enum AuditActorType {
  user
  invitee
  system
}

/// A record of who did what to which account or profile, and when. The app only ever adds rows. The table has no
/// foreign keys and keeps copies of the emails, so a record stays readable after the user or profile it names is deleted.
model AuditEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  action      AuditAction
  actorType   AuditActorType @map("actor_type")
  /// The signed-in user who did it; null for a new joiner or the system.
  actorUserId String?        @map("actor_user_id") @db.Uuid
  /// The actor's email at the time; null for the system.
  actorEmail  String?        @map("actor_email")
  /// The user or profile the action was done to.
  targetId    String         @map("target_id") @db.Uuid
  /// The target's email at the time.
  targetEmail String         @map("target_email")
  /// Facts about the change, such as the old and new role or the names of the fields that changed. Never field values,
  /// so the log does not become a second copy of personal information.
  details     Json?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

/// Settings that can change without a code change, such as the combined character limit.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}
