# Copy to .env and fill in real values. Real .env* files are gitignored.
# .env is read by Next.js, the Prisma CLI (prisma.config.ts) and Docker Compose.

# Local PostgreSQL started by `npm run db:up` (docker-compose.yml).
POSTGRES_USER=gtkm
POSTGRES_PASSWORD=
POSTGRES_DB=gtkm

# Prisma connection string; must match the values above for local development.
DATABASE_URL="postgresql://gtkm:<password>@localhost:5432/gtkm?schema=public"

# First admin for local development, created by `npm run db:seed`. Leave empty to skip.
# Use a test account and a throwaway password (at least 12 characters); never real credentials.
# Not used in production, where the first admin is created another way.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
